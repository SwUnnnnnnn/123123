rules_version = '2';

service cloud.firestore {
  function signedIn() {
    return request.auth != null;
  }

  match /databases/{database}/documents {
    function areFriends(firstUserId, secondUserId) {
      let forwardRequestId = firstUserId + '_' + secondUserId;
      let reverseRequestId = secondUserId + '_' + firstUserId;
      let forwardPath = /databases/$(database)/documents/friendRequests/$(forwardRequestId);
      let reversePath = /databases/$(database)/documents/friendRequests/$(reverseRequestId);
      return (exists(forwardPath) && get(forwardPath).data.status == 'accepted')
        || (exists(reversePath) && get(reversePath).data.status == 'accepted');
    }

    function isBlocked(firstUserId, secondUserId) {
      return exists(/databases/$(database)/documents/users/$(firstUserId)/blocks/$(secondUserId));
    }

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'firstName', 'lastName', 'nickname', 'email', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'nickname', 'email', 'createdAt', 'avatarDataUrl'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 50
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 50
        && request.resource.data.nickname is string
        && request.resource.data.nickname.matches('^[A-Za-zА-Яа-яЁё0-9_]{3,24}$')
        && (!('avatarDataUrl' in request.resource.data)
          || (request.resource.data.avatarDataUrl is string
            && request.resource.data.avatarDataUrl.size() <= 700000
            && request.resource.data.avatarDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$')))
        && request.resource.data.createdAt == request.time
        && request.resource.data.email == request.auth.token.email;

      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'nickname', 'avatarDataUrl'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 50
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 50
        && request.resource.data.nickname is string
        && request.resource.data.nickname.matches('^[A-Za-zА-Яа-яЁё0-9_]{3,24}$')
        && (!('avatarDataUrl' in request.resource.data)
          || (request.resource.data.avatarDataUrl is string
            && request.resource.data.avatarDataUrl.size() <= 700000
            && request.resource.data.avatarDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$')))
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'firstName', 'lastName', 'nickname', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'nickname', 'avatarDataUrl', 'updatedAt'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 50
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 50
        && request.resource.data.nickname is string
        && request.resource.data.nickname.matches('^[A-Za-zА-Яа-яЁё0-9_]{3,24}$')
        && (!('avatarDataUrl' in request.resource.data)
          || (request.resource.data.avatarDataUrl is string
            && request.resource.data.avatarDataUrl.size() <= 700000
            && request.resource.data.avatarDataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$')))
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && (resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'senderId', 'receiverId', 'status', 'createdAt', 'senderSeen', 'receiverSeen'
        ])
        && request.resource.data.keys().hasOnly([
          'senderId', 'receiverId', 'status', 'createdAt', 'senderSeen', 'receiverSeen'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.auth.uid
        && requestId == request.resource.data.senderId + '_' + request.resource.data.receiverId
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.receiverId))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.senderSeen == true
        && request.resource.data.receiverSeen == false;
      allow update: if request.auth != null
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && (
          (resource.data.senderId == request.auth.uid
            && resource.data.status == 'declined'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'createdAt', 'senderSeen', 'receiverSeen'
            ])
            && request.resource.data.status == 'pending'
            && request.resource.data.createdAt == request.time
            && request.resource.data.senderSeen == true
            && request.resource.data.receiverSeen == false)
          || (resource.data.receiverId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'receiverSeen', 'senderSeen', 'respondedAt'
            ])
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.receiverSeen == true
            && request.resource.data.senderSeen == false
            && request.resource.data.respondedAt == request.time)
          || (resource.data.receiverId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiverSeen'])
            && request.resource.data.receiverSeen == true)
          || (resource.data.senderId == request.auth.uid
            && resource.data.status in ['accepted', 'declined']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['senderSeen'])
            && request.resource.data.senderSeen == true)
        );
      allow delete: if signedIn()
        && resource.data.status == 'accepted'
        && (resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid)
        && requestId == resource.data.senderId + '_' + resource.data.receiverId;
    }

    match /users/{userId}/blocks/{blockedUserId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && blockedUserId != userId
        && request.resource.data.keys().hasOnly(['blockedUserId', 'createdAt'])
        && request.resource.data.blockedUserId == blockedUserId
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'members', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'members', 'createdAt'
        ])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string
        && request.resource.data.members[1] is string
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && (
          chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
          || chatId == request.resource.data.members[1] + '_' + request.resource.data.members[0]
        )
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'lastMessageSender', 'lastMessageId'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 4000
        && request.resource.data.lastMessageSender == request.auth.uid
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.lastMessageId is string
        && request.resource.data.lastMessageId.size() > 0
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderId == request.auth.uid
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.text == request.resource.data.lastMessage
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.createdAt == request.time
        && areFriends(resource.data.members[0], resource.data.members[1])
        && !isBlocked(resource.data.members[0], resource.data.members[1])
        && !isBlocked(resource.data.members[1], resource.data.members[0]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessage == request.resource.data.text
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessageSender == request.auth.uid
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessageId == messageId
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessageAt == request.time
          && areFriends(
            get(/databases/$(database)/documents/chats/$(chatId)).data.members[0],
            get(/databases/$(database)/documents/chats/$(chatId)).data.members[1]
          )
          && !isBlocked(
            get(/databases/$(database)/documents/chats/$(chatId)).data.members[0],
            get(/databases/$(database)/documents/chats/$(chatId)).data.members[1]
          )
          && !isBlocked(
            get(/databases/$(database)/documents/chats/$(chatId)).data.members[1],
            get(/databases/$(database)/documents/chats/$(chatId)).data.members[0]
          );
        allow update, delete: if false;
      }
    }

    match /chatSettings/{userId}/chats/{chatId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && isChatMember(chatId)
        && request.resource.data.keys().hasAll([
          'muted', 'pinned', 'archived', 'hidden', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'muted', 'pinned', 'archived', 'hidden', 'lastReadAt', 'updatedAt'
        ])
        && request.resource.data.muted is bool
        && request.resource.data.pinned is bool
        && request.resource.data.archived is bool
        && request.resource.data.hidden is bool
        && (!('lastReadAt' in request.resource.data) || request.resource.data.lastReadAt is timestamp)
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
